{
  "name": "Bustub UNC Development",
  "image": "ubuntu:22.04",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "CC": "clang-15",
    "CXX": "clang++-15"
  },
  "runArgs": [
    "--security-opt", "seccomp=unconfined",
    "--cap-add", "SYS_PTRACE"
  ],
  // Wait for postCreateCommand (which configures CMake and generates
  // build/compile_commands.json) to finish before VS Code connects and starts
  // clangd. Otherwise clangd starts before the compile DB exists and can't find
  // it, requiring a manual "clangd: Restart language server".
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "C_Cpp.intelliSenseEngine": "disabled",
        "cmake.configureOnOpen": true,
        "cmake.useCMakePresets": "always",
        "cmake.debugConfig": {
          "environment": [
            { "name": "ASAN_OPTIONS", "value": "detect_leaks=0" }
          ]
        },
        "clangd.path": "clangd-15",
        "clangd.arguments": [
          "--background-index"
        ]
      }
    }
  },
  "postCreateCommand" : "echo y | ./build_support/packages.sh; git remote add public https://github.com/bsb20/bustub; cmake --preset debug"
}
