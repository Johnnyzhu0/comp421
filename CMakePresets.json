{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Shared settings; compilers come from CC/CXX in the environment",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUSTUB_SANITIZER": "address"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug (TSan)",
      "description": "Debug build with the thread sanitizer (see P0)",
      "inherits": "debug",
      "cacheVariables": {
        "BUSTUB_SANITIZER": "thread"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "base",
      "hidden": true,
      "jobs": 0
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "configurePreset": "debug"
    },
    {
      "name": "tsan",
      "displayName": "Debug (TSan)",
      "inherits": "base",
      "configurePreset": "tsan"
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "inherits": "base",
      "configurePreset": "relwithdebinfo"
    }
  ]
}
